{
  "name": "zhihuhelp",
  "version": "2.5.1",
  "description": "知乎助手 & TypeScript",
  "repository": {
    "type": "git",
    "url": "https://github.com/YaoZeyuan/zhihuhelp"
  },
  "main": "dist/index.js",
  "author": "姚泽源",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "startgui": "node client/script/start.js",
    "buildgui": "node client/script/build.js",
    "start": "electron dist/index.js  --zhihuhelp-debug",
    "ace": "node dist/ace.js",
    "watch": "tsc -w",
    "build": "tsc && node scripts/copy-assets.js",
    "build-without-sourcemap": "tsc --sourceMap false && node scripts/copy-assets.js",
    "pack": "npm run build-without-sourcemap && npm run buildgui && electron-builder --dir",
    "dist": "npm run build-without-sourcemap && npm run buildgui && electron-builder",
    "electron-builder": "electron-builder",
    "postinstall-4-mac": "electron-rebuild -f -w sharp",
    "postinstall-4-win": "electron-builder install-app-deps",
    "server": "nodemon --inspect dist/start-dev-server.js",
    "tsc": "tsc",
    "lint": "tsc && NODE_ENV=production eslint src",
    "eslint": "eslint src",
    "prettier-with-fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,less,css}\""
  },
  "build": {
    "productName": "知乎助手",
    "appId": "zhihuhelp",
    "copyright": "@姚泽源",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "msi"
      ],
      "artifactName": "zhihuhelp-${version}-${os}-${arch}.${ext}",
      "icon": "src/public/icon/icon.ico"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "zhihuhelp-${version}-${os}-${arch}.${ext}",
      "icon": "src/public/icon/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@types/tiny-async-pool": "^2.0.0",
    "adm-zip": "^0.5.10",
    "axios": "^1.19.0",
    "core-js": "3",
    "dayjs": "^1.11.19",
    "json5": "^2.2.1",
    "knex": "^2.1.0",
    "lodash": "^4.17.21",
    "lru-cache": "^8.0.4",
    "md5": "^2.2.1",
    "module-alias": "^2.2.2",
    "puppeteer-core": "^24.39.1",
    "query-string": "^6.4.2",
    "rc-field-form": "^1.28.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "semver": "^7.3.7",
    "sharp": "0.33.5",
    "shelljs": "^0.8.1",
    "sqlite3": "5.1.7",
    "tiny-async-pool": "^2.1.0",
    "turndown": "^7.2.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "electron",
      "sharp",
      "sqlite3"
    ]
  },
  "devDependencies": {
    "@electron/osx-sign": "^2.6.2",
    "@electron/rebuild": "^3.2.10",
    "@types/adm-zip": "^0.5.0",
    "@types/archiver": "^5.3.1",
    "@types/body-parser": "^1.19.2",
    "@types/express": "^4.17.14",
    "@types/json5": "0.0.30",
    "@types/knex": "^0.15.1",
    "@types/lodash": "^4.14.91",
    "@types/md5": "^2.1.33",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/semver": "^7.3.10",
    "@types/sharp": "^0.25.0",
    "@types/shelljs": "^0.7.8",
    "@types/turndown": "^5.0.6",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "eslint": "^8.13.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-prettier": "^4.0.0",
    "node-gyp": "^8.4.0",
    "nodemon": "^2.0.20",
    "prettier": "^2.7.1",
    "typescript": "^5.9.3"
  }
}